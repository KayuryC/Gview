// Gview — Schema Prisma
// Banco: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PLAYER
  DEVELOPER
  ADMIN
}

enum GameStatus {
  FEATURED
  AVAILABLE
  COMING_SOON
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum GameJamStatus {
  UPCOMING
  ACTIVE
  FINISHED
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(PLAYER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  wishlist   Wishlist[]
  reviews    Review[]
  gameJams   GameJam[]
  jamEntries GameJamEntry[]
}

model Game {
  id               String     @id @default(uuid())
  title            String
  slug             String     @unique
  shortDescription String
  fullDescription  String?
  coverUrl         String?
  trailerUrl       String?
  demoUrl          String?
  status           GameStatus @default(AVAILABLE)
  genre            String?
  studioName       String?
  launchWindow     String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  wishlist   Wishlist[]
  reviews    Review[]
  jamEntries GameJamEntry[]
}

model Wishlist {
  id        String   @id @default(uuid())
  userId    String
  gameId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId])
}

model Review {
  id        String   @id @default(uuid())
  userId    String
  gameId    String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId])
}

model Submission {
  id                    String           @id @default(uuid())
  gameTitle             String
  projectUrl            String?
  description           String
  launchPlans           String?
  targetPlatforms       String?
  launchDateRange       String?
  demoLink              String?
  nextFestParticipation Boolean          @default(false)
  heardAbout            String?
  additionalInfo        String?
  contactRole           String?
  contactEmail          String
  studioName            String?
  attachmentUrl         String?
  reviewStatus          SubmissionStatus @default(PENDING)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
}

model GameJam {
  id          String        @id @default(uuid())
  title       String
  description String
  theme       String?
  startDate   DateTime
  endDate     DateTime
  status      GameJamStatus @default(UPCOMING)
  creatorId   String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  creator User           @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  entries GameJamEntry[]
}

model GameJamEntry {
  id          String   @id @default(uuid())
  jamId       String
  gameId      String
  developerId String
  createdAt   DateTime @default(now())

  jam       GameJam @relation(fields: [jamId], references: [id], onDelete: Cascade)
  game      Game    @relation(fields: [gameId], references: [id], onDelete: Cascade)
  developer User    @relation(fields: [developerId], references: [id], onDelete: Cascade)

  @@unique([jamId, gameId])
}
